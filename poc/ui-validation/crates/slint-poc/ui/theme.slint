// Shared visual language for the Arcline Slint validation shell.
// The colours and 10 pt card radius mirror the approved egui shell.

export global Theme {
    out property <color> window-bg: #121316;
    out property <color> card: #1d1f25;
    out property <color> card-deep: #17191e;
    out property <color> card-raised: #24272e;
    out property <color> border: #2f333b;
    out property <color> border-soft: #262a31;
    out property <color> text: #e6e8ec;
    out property <color> text-dim: #8a9099;
    out property <color> text-faint: #60666f;
    out property <color> accent: #4c8dff;
    out property <color> accent-soft: #2b4d86;
    out property <color> playhead: #ff5c5c;
    out property <color> warning: #ffd65c;
    out property <color> video: #2e5b8a;
    out property <color> overlay: #3d6b4f;
    out property <color> title: #7a4a3a;
    out property <color> audio: #5a467a;
    out property <color> music: #6b5f2e;
    out property <color> sfx: #3a6a72;

    out property <length> radius: 10px;
    out property <length> small-radius: 5px;
    out property <length> hairline: 1px;
}
