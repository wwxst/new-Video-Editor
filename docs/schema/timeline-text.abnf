; arcline timeline text format — version 1
; Normative grammar for the read-only inspect.timeline view (docs/06-agent-interface.md §5).
; timeline.apply_text (parsing a rewritten timeline into commands) is deferred to post-1.0; the grammar is
; published now so readers and future writers share one definition.
; Lines terminate with LF or CRLF. A line beginning with '#' (after optional WSP) is a comment.
; Times are non-drop-frame HH:MM:SS:FF at the sequence nominal rate (docs/02 §2.3). Drop-frame notation
; HH:MM:SS;FF MUST NOT appear in this format, regardless of the sequence's timecode_display setting.
; The version line MUST be the first line.
; Terminology follows docs/02 §2.1: "fps=" carries the frame RATE (frames per second, e.g. 30000/1001);
; the stored frame DURATION (1001/30000) never appears in this format.
; This grammar is frozen at v1; additions require a new format version.

timeline        = version-line sequence-line *WSP
                  *( track / marker-block / comment-line / blank-line )

version-line    = "# arcline timeline v1" endl
sequence-line   = "SEQ" 1*WSP quoted-name 1*WSP resolution 1*WSP "fps=" frame-rate
                  1*WSP "dur=" timecode endl

resolution      = 1*DIGIT "x" 1*DIGIT          ; 1920x1080
frame-rate      = 1*DIGIT "/" 1*DIGIT          ; frames per second, e.g. 30000/1001 or 25/1
timecode        = 1*2DIGIT ":" 2DIGIT ":" 2DIGIT ":" 2DIGIT
number          = ["-"] 1*DIGIT ["." 1*DIGIT]
boolean         = "true" / "false"

track           = "TRK" 1*WSP track-kind 1*DIGIT *( 1*WSP track-attr ) *WSP endl
                  *( clip / blank-line )
track-kind      = "V" / "A" / "S"              ; video / audio / subtitle (kind is fixed per track)
track-attr      = "name=" quoted-name
                / "op=" number                  ; video track opacity
                / "gain=" db                    ; audio track gain
                / "enabled=" boolean
                / "locked=" boolean

db              = number "dB"                   ; e.g. -6.0dB (may also be written as -6dB)

clip            = 2*WSP "[" clip-id "]" 1*WSP source 1*WSP
                  "in=" timecode 1*WSP "len=" timecode 1*WSP "@" timecode
                  *( 1*WSP clip-attr ) *WSP endl

clip-id         = 1*( ALPHA / DIGIT / "_" )
source          = quoted-name                   ; asset file name as shown in the media bin
                / "<<" 1*WSP generator 1*WSP ">>"
generator       = "TITLE" 1*WSP quoted-name     ; e.g. <<TITLE "Chapter One">>

clip-attr       = "fx=" effect-name [ "(" [ param-list ] ")" ]
                / "style=" style-name
                / "fade=" fade-spec
                / "speed=" number ["x"]
                / "label=" quoted-name

effect-name     = 1*( ALPHA / DIGIT / "." / "_" )
param-list      = param *( "," param )
param           = 1*( ALPHA / DIGIT / "_" ) "=" value
value           = quoted-name / number / boolean

fade-spec       = "in:" duration [ "," "out:" duration ]
duration        = number ( "ms" / "s" )         ; e.g. 500ms, 2s

style-name      = 1*( ALPHA / DIGIT / "_" )

marker-block    = "MARK" endl *( 2*WSP timecode *WSP quoted-name *( 1*WSP marker-attr ) endl )
marker-attr     = "color=" hex-color
hex-color       = "#" 6HEXDIG

quoted-name     = DQUOTE *( %x20-21 / %x23-7E / UTF8-2 / UTF8-3 / UTF8-4 ) DQUOTE
                  ; any printable character except '"'; UTF-8 permitted; '\' escapes are not used —
                  ; names containing '"' are not representable and MUST be rejected at write time.

comment-line    = *WSP "#" *( %x20-7E / UTF8-2 / UTF8-3 / UTF8-4 ) endl
blank-line      = *WSP endl
endl            = CRLF / LF
